{
  "meta": {
    "lastTouchedVersion": "2026.3.2",
    "lastTouchedAt": "2026-03-26T17:01:05.051Z"
  },
  "auth": {
    "profiles": {
      "openai:default": {
        "provider": "openai",
        "mode": "api_key"
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "openai/gpt-5.1-codex"
      },
      "models": {
        "openai/gpt-5.1-codex": {
          "alias": "GPT"
        }
      },
      "workspace": "/Users/stevedang/Documents/C++/ailiteracy-openclaw/workspace",
      "compaction": {
        "mode": "safeguard"
      }
    },
    "list": [
      {
        "id": "my_agent",
        "default": true,
        "name": "Carbon-Based Caleb",
        "workspace": "./workspace",
        "identity": {
          "name": "Carbon-Based Caleb"
        }
      }
    ]
  },
  "tools": {
    "profile": "messaging"
  },
  "bindings": [
    {
      "agentId": "my_agent",
      "match": {
        "channel": "discord"
      }
    }
  ],
  "commands": {
    "native": "auto",
    "nativeSkills": "auto",
    "restart": true,
    "ownerDisplay": "raw"
  },
  "session": {
    "dmScope": "per-channel-peer"
  },
  "channels": {
    "discord": {
      "enabled": true,
      "token": "${DISCORD_TOKEN}",
      "groupPolicy": "allowlist",
      "streaming": "off",
      "dmPolicy": "disabled",
      "guilds": {
        "${DISCORD_GUILD_ID}": {
          "requireMention": false,
          "channels": {
            "${INFO_ANNOUNCEMENTS_CHANNEL_ID}": {
              "allow": true,
              "requireMention": false
            },
            "${ACTIVE_TOPICS_CATEGORY_ID}": {
              "allow": true,
              "requireMention": false
            },
            "${ARCHIVED_CATEGORY_ID}": {
              "allow": true,
              "requireMention": false
            }
          }
        },
        "discord-guild-id": {
          "channels": {
            "info-announcements-channel-id": {
              "allow": true
            },
            "active-topics-category-id": {
              "allow": true
            },
            "archived-category-id": {
              "allow": true
            }
          }
        }
      },
      "threadBindings": {
        "enabled": true
      }
    }
  },
  "gateway": {
    "port": 18789,
    "mode": "local",
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": "e602c3556a619387eb4705d1c11964777d500cb600bd9529"
    },
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    }
  }
}
